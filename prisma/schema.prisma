generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Adoption {
  id        BigInt          @id @default(autoincrement())
  userId    String          @map("user_id") @db.Uuid
  animalId  BigInt          @map("animal_id")
  status    adoption_status? @default(pendiente)
  message   String?
  statusMessage String?     @map("status_message")
  createdAt DateTime?       @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime?       @default(now()) @map("updated_at") @db.Timestamp(6)
  animal    Animal          @relation(fields: [animalId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([animalId], map: "idx_adoptions_animal")
  @@index([userId], map: "idx_adoptions_user")
  @@map("adoptions")
}

model AnimalImage {
  id        BigInt    @id @default(autoincrement())
  animalId  BigInt    @map("animal_id")
  imageUrl  String    @map("image_url")
  isMain    Boolean?  @default(false) @map("is_main")
  createdAt DateTime? @default(now()) @map("created_at") @db.Timestamp(6)
  animal    Animal    @relation(fields: [animalId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("animal_images")
}

model Animal {
  id              BigInt         @id @default(autoincrement())
  shelterId       BigInt         @map("shelter_id")
  name            String         @db.VarChar(120)
  species         String         @db.VarChar(80)
  breed           String?        @db.VarChar(120)
  sex             animal_sex?
  birthDate       DateTime?      @map("birth_date") @db.Date
  weight          Decimal?       @db.Decimal(5, 2)
  description     String?
  status          animal_status? @default(available)
  vaccinated      Boolean?       @default(false)
  sterilized      Boolean?       @default(false)
  goodWithAnimals Boolean?       @map("good_with_animals")
  goodWithKids    Boolean?       @map("good_with_kids")
  energyLevel     String?        @map("energy_level") @db.VarChar(50)
  arrivalDate     DateTime?      @map("arrival_date") @db.Date
  createdAt       DateTime?      @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt       DateTime?      @default(now()) @map("updated_at") @db.Timestamp(6)
  adoptions       Adoption[]
  images          AnimalImage[]
  shelter         Shelter        @relation(fields: [shelterId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  likes           Like[]
  sponsorships    Sponsorship[]

  @@index([shelterId], map: "idx_animals_shelter")
  @@index([species], map: "idx_animals_species")
  @@index([status], map: "idx_animals_status")
  @@map("animals")
}

model Like {
  userId    String    @map("user_id") @db.Uuid
  animalId  BigInt    @map("animal_id")
  createdAt DateTime? @default(now()) @map("created_at") @db.Timestamp(6)
  animal    Animal    @relation(fields: [animalId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([userId, animalId])
  @@index([animalId], map: "idx_likes_animal")
  @@index([userId], map: "idx_likes_user")
  @@map("likes")
}

model Notification {
  id        BigInt    @id @default(autoincrement())
  userId    String    @map("user_id") @db.Uuid
  title     String    @db.VarChar(255)
  body      String?
  isRead    Boolean?  @default(false) @map("is_read")
  createdAt DateTime? @default(now()) @map("created_at") @db.Timestamp(6)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId], map: "idx_notifications_user")
  @@map("notifications")
}

model PaymentHistory {
  id                BigInt      @id @default(autoincrement())
  sponsorshipId     BigInt      @map("sponsorship_id")
  amount            Decimal     @db.Decimal(10, 2)
  paymentMethod     String?     @map("payment_method") @db.VarChar(50)
  paymentReference  String?     @map("payment_reference")
  paidAt            DateTime?   @default(now()) @map("paid_at") @db.Timestamp(6)
  sponsorship       Sponsorship @relation(fields: [sponsorshipId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("payment_history")
}

model ShelterMember {
  id        BigInt    @id @default(autoincrement())
  shelterId BigInt    @map("shelter_id")
  userId    String    @map("user_id") @db.Uuid
  role      String?   @default("worker") @db.VarChar(50)
  createdAt DateTime? @default(now()) @map("created_at") @db.Timestamp(6)
  shelter   Shelter   @relation(fields: [shelterId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([shelterId, userId])
  @@map("shelter_members")
}

model Shelter {
  id            BigInt          @id @default(autoincrement())
  name          String          @db.VarChar(150)
  description   String?
  email         String?         @db.VarChar(255)
  phone         String?         @db.VarChar(30)
  websiteUrl    String?         @map("website_url")
  logoUrl       String?         @map("logo_url")
  coverImageUrl String?         @map("cover_image_url")
  address       String?
  city          String?         @db.VarChar(100)
  country       String?         @db.VarChar(100)
  latitude      Decimal?        @db.Decimal(10, 8)
  longitude     Decimal?        @db.Decimal(11, 8)
  verified      Boolean?        @default(false)
  verifiedAt    DateTime?       @map("verified_at") @db.Timestamp(6)
  createdAt     DateTime?       @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt     DateTime?       @default(now()) @map("updated_at") @db.Timestamp(6)
  animals       Animal[]
  members       ShelterMember[]

  @@index([latitude, longitude], map: "idx_shelters_location")
  @@map("shelters")
}

model Sponsorship {
  id            BigInt             @id @default(autoincrement())
  userId        String             @map("user_id") @db.Uuid
  animalId      BigInt             @map("animal_id")
  monthlyAmount Decimal            @map("monthly_amount") @db.Decimal(10, 2)
  status        sponsorship_status? @default(active)
  startDate     DateTime?          @default(dbgenerated("CURRENT_DATE")) @map("start_date") @db.Date
  endDate       DateTime?          @map("end_date") @db.Date
  createdAt     DateTime?          @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt     DateTime?          @default(now()) @map("updated_at") @db.Timestamp(6)
  payments      PaymentHistory[]
  animal        Animal             @relation(fields: [animalId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([animalId], map: "idx_sponsorships_animal")
  @@index([userId], map: "idx_sponsorships_user")
  @@map("sponsorships")
}

model User {
  id             String          @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  username       String          @unique @db.VarChar(50)
  email          String          @unique @db.VarChar(255)
  passwordHash   String          @map("password_hash")
  fullName       String?         @map("full_name") @db.VarChar(150)
  role           user_role       @default(usuario)
  description    String?
  avatarUrl      String?         @map("avatar_url")
  phone          String?         @db.VarChar(30)
  isVerified     Boolean?        @default(false) @map("is_verified")
  createdAt      DateTime?       @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt      DateTime?       @default(now()) @map("updated_at") @db.Timestamp(6)
  adoptions      Adoption[]
  likes          Like[]
  notifications  Notification[]
  shelterMembers ShelterMember[]
  sponsorships   Sponsorship[]

  @@map("users")
}

enum adoption_status {
  pendiente
  aprovado
  rechazado
  completado
}

enum animal_sex {
  male
  female
}

enum animal_status {
  available
  reserved
  adopted
  medical_hold
}

enum sponsorship_status {
  active
  cancelled
  paused
}

  enum user_role {
    administrador
    usuario
    trabajador
  }